<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      Für die Selbstaktualisierung. Ab Android 8 Pflicht, damit der System-Dialog überhaupt
      erscheint; der Nutzer muss MSF beim ersten Mal zusätzlich in den Systemeinstellungen
      freigeben. Der Preis, der genannt gehört: Ab hier kann jeder Code-Ausführungsfehler in
      MSF die Installation einer beliebigen APK anstossen, und der Nutzer sähe einen echten
      Systemdialog. Deshalb prüft UpdateService Hash, Paketname und Signatur, bevor überhaupt
      ein Installer geöffnet wird.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Kein Cloud-Backup. Androids Voreinstellung hätte `shared_prefs/storyforge_prefs.xml`
      mit dem Gemini-Schlüssel im Klartext und die komplette Room-Datenbank mit allen
      Geschichten, Figuren und Notizen an Google übertragen und auf jedem weiteren Gerät des
      Kontos wiederhergestellt — auf Android 7 bis 11 zusätzlich ohne clientseitige
      Verschlüsselung und per `adb backup` ohne Root abgreifbar. Das widerspricht der
      Datenhoheits-Zusage (CLAUDE.md §4, §6) und kostet den Preis, dass Spielstände beim
      Gerätewechsel nicht automatisch mitwandern.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Reicht die heruntergeladene APK als content://-URI an den System-Installer.
          exported="false" plus grantUriPermissions="true" heisst: Kein fremder Prozess kommt
          an den Provider heran, ausser über einen URI, den MSF ihm für genau einen Vorgang
          mit FLAG_GRANT_READ_URI_PERMISSION gereicht hat.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
